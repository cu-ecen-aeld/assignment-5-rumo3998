#!/bin/sh

case "$1" in
  start)
    echo "Loading ldd3 modules"
    
    # Navigate to where Buildroot installs your out-of-tree kernel modules
    cd /lib/modules/*/updates/
    
    /usr/bin/scull_load
    /usr/bin/faulty_load faulty
    modprobe hello
    ;;
  stop)
    echo "Unloading ldd3 modules"
    cd /lib/modules/*/updates/
    
    rmmod hello
    /usr/bin/faulty_unload faulty
    /usr/bin/scull_unload
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
